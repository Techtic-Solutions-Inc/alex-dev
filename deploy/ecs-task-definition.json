{
  "containerDefinitions": [
    {
      "name": "fastapi-backend",
      "image": "fastapi-backend:latest",
      "essential": true,
      "environment": [
        {
          "name": "APP_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:fastapi-backend/APP_BASE_URL"
        },
        {
          "name": "SENDGRID_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:fastapi-backend/SENDGRID_API_KEY"
        },
        {
          "name": "SENDGRID_FROM_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:fastapi-backend/SENDGRID_FROM_EMAIL"
        },
        {
          "name": "SENDGRID_PASSWORD_RESET_TEMPLATE_ID",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:fastapi-backend/SENDGRID_PASSWORD_RESET_TEMPLATE_ID"
        }
      ]
    }
  ]
}
