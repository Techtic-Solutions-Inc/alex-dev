# Copy to your secrets manager or create a Kubernetes Secret before apply.
# kubectl create secret generic backend-api-secrets \
#   --namespace backend-api-production \
#   --from-env-file=deploy/kubernetes/secrets/backend-api-secrets.env
DATABASE_URL=mongodb://username:password@mongo.example.com:27017/agentwise?authSource=admin
MIGRATIONS_DATABASE_URL=mongodb://username:password@mongo.example.com:27017/agentwise?authSource=admin
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_CONNECTION=Username-Password-Authentication
AUTH0_AUDIENCE=https://api.example.com
SENDGRID_API_KEY=SG.replace-with-your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@example.com
EMAIL_VERIFICATION_URL=https://api.example.com/api/v1/auth/verify-email