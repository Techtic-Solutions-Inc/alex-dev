{
  "name": "backend-api",
  "version": "1.0.0",
  "description": "Production-ready NestJS API foundation",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "test": "jest --config jest.config.js --selectProjects unit --runInBand --ci 2>&1",
    "test:unit": "jest --config jest.config.js --selectProjects unit --runInBand --ci 2>&1",
    "test:watch": "jest --config jest.config.js --selectProjects unit --watch",
    "test:cov": "jest --config jest.config.js --selectProjects unit --coverage",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e --runInBand --ci 2>&1",
    "test:integration": "npm run test:e2e",
    "test:migrations": "jest --config jest.config.js --selectProjects unit --testPathPattern=migration-runner.spec.ts --runInBand --ci",
    "migration:status": "ts-node -r tsconfig-paths/register src/database/migrations/migration.cli.ts status",
    "migration:up": "ts-node -r tsconfig-paths/register src/database/migrations/migration.cli.ts up",
    "migration:down": "ts-node -r tsconfig-paths/register src/database/migrations/migration.cli.ts down",
    "migration:status:prod": "node dist/database/migrations/migration.cli.js status",
    "migration:up:prod": "node dist/database/migrations/migration.cli.js up",
    "migration:down:prod": "node dist/database/migrations/migration.cli.js down",
    "docker:smoke": "bash scripts/docker-smoke-test.sh",
    "kube:validate": "bash scripts/kube-validate.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@sendgrid/mail": "^8.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dd-trace": "^5.35.0",
    "mongoose": "^9.9.2",
    "newrelic": "^12.18.0",
    "passport-jwt": "^4.0.1",
    "rate-limiter-flexible": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.4.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "mongodb": "6.22.0"
  }
}