NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_SERVICE_NAME=backend-api
# Optional direct log shipping (Logstash HTTP input). Stdout JSON is collected in Kubernetes via Fluent Bit.
LOGSTASH_ENABLED=false
LOGSTASH_HTTP_URL=
LOGSTASH_BATCH_SIZE=25
LOGSTASH_FLUSH_INTERVAL_MS=2000

# Database Configuration
# Primary connection string (used by the application).
DATABASE_URL=mongodb://username:password@localhost:27017/mydatabase?authSource=admin
# Alias accepted by configuration bootstrap; maps to DATABASE_URL when unset.
MONGODB_URI=mongodb://username:password@localhost:27017/mydatabase?authSource=admin
# Optional dedicated URI for migration jobs. When unset, DATABASE_URL is used.
MIGRATIONS_DATABASE_URL=mongodb://username:password@localhost:27017/mydatabase?authSource=admin
# An identifier for the deployment running migrations, useful in lock diagnostics.
MIGRATION_RUNNER_ID=local-development
# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Canonical seconds-based expiry values used by the API runtime.
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=86400
# Auth0 database-connection login. Configure these values in deployed
# environments to delegate credential verification and token issuance to Auth0.
# The Auth0 application must enable the password-realm grant.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_CONNECTION=Username-Password-Authentication
AUTH0_AUDIENCE=https://api.example.com
AUTH0_SCOPE=openid profile email offline_access
# SendGrid is optional for local development. In deployed environments set all
# three values so new users receive their verification link.
SENDGRID_API_KEY=SG.replace-with-your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@example.com
EMAIL_VERIFICATION_URL=http://localhost:3000/api/v1/auth/verify-email
# Frontend Sign In link returned on visitor sign-up success (path or absolute URL).
VISITOR_SIGN_IN_URL=/sign-in
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
CORS_ORIGIN=*
# TLS / transport security (optional for local HTTP; required when terminating TLS in the Node process)
TLS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=
TRUST_PROXY=false
FORCE_HTTPS=false
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
RATE_LIMIT_POINTS=5
RATE_LIMIT_DURATION=1
# fixed | sliding
RATE_LIMIT_STRATEGY=fixed
# Application Performance Monitoring (optional)
APM_ENABLED=false
APM_PROVIDER=datadog
APM_SLOW_REQUEST_THRESHOLD_MS=2000
# Prometheus metrics exposition (scraped at GET /metrics)
METRICS_ENABLED=false
METRICS_PREFIX=backend_api
DD_SERVICE=backend-api
DD_ENV=development
DD_VERSION=1.0.0
DD_AGENT_HOST=127.0.0.1
DD_TRACE_AGENT_PORT=8126
DD_PROFILING_ENABLED=false
NEW_RELIC_APP_NAME=backend-api
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_LOG_LEVEL=info
