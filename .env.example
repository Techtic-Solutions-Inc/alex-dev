NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=mongodb://username:password@localhost:27017/mydatabase?authSource=admin
# Optional dedicated URI for migration jobs. When unset, DATABASE_URL is used.
MIGRATIONS_DATABASE_URL=mongodb://username:password@localhost:27017/mydatabase?authSource=admin
# An identifier for the deployment running migrations, useful in lock diagnostics.
MIGRATION_RUNNER_ID=local-development
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=86400
# Auth0 database-connection login. Configure these values in deployed
# environments to delegate credential verification and token issuance to Auth0.
# The Auth0 application must enable the password-realm grant.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_CONNECTION=Username-Password-Authentication
AUTH0_AUDIENCE=https://api.example.com
AUTH0_SCOPE=openid profile email offline_access
# SendGrid is optional for local development. In deployed environments set all
# three values so new users receive their verification link.
SENDGRID_API_KEY=SG.replace-with-your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@example.com
EMAIL_VERIFICATION_URL=http://localhost:3000/api/auth/verify-email
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
CORS_ORIGIN=*
RATE_LIMIT_POINTS=5
RATE_LIMIT_DURATION=1
# Google Analytics Measurement Protocol. Optional locally; when unset, tracking is skipped.
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_ANALYTICS_API_SECRET=replace-with-ga4-api-secret
