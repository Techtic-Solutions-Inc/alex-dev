# PostgreSQL connection URL. Do not use a production database for tests.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/backend
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/backend_test

# Use a unique, high-entropy value outside local development.
JWT_SECRET=change-this-development-secret-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=86400

APP_NAME=Backend API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
