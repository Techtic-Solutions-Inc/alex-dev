# Database Configuration (also used by Alembic migrations via src/migrations/env.py)
DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
DATABASE_URL_TEST=postgresql+asyncpg://user:password@localhost/test_dbname

# JWT Configuration
JWT_SECRET=mysecretkey
JWT_EXPIRY=3600
REMEMBER_ME_JWT_EXPIRY_DAYS=30
JWT_REMEMBER_ME_EXPIRY=

# Auth0 Configuration (optional)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_WEBHOOK_SECRET=

# Logging Configuration
LOG_LEVEL=INFO

# SendGrid Email Configuration
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_CONFIRMATION_TEMPLATE_ID=
APP_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
