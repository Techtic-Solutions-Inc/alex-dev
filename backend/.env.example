# Application
APP_NAME=Backend API
APP_VERSION=1.0.0
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# MongoDB
MONGODB_URL=mongodb://username:password@localhost:27017/?authSource=admin
DB_NAME=app
MIGRATIONS_COLLECTION=_migrations
MIGRATIONS_LOCK_COLLECTION=_migration_locks
MIGRATION_LOCK_TIMEOUT_SECONDS=60

# JWT: generate a unique high-entropy secret per environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=backend-api
JWT_AUDIENCE=backend-clients
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=86400
EMAIL_VERIFICATION_EXPIRY_SECONDS=86400

# SendGrid email verification
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@example.com
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
